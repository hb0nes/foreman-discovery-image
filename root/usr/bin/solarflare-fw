#!/bin/bash

if ! dmesg | grep -qi 'sfc'; then
  echo 'No SolarFlare NICs detected.'
  exit 0
fi

if ! sfupdate | grep -qi 'more recent'; then
  echo 'Firmware does not need updating.'
  exit 0
fi

if [[ $(modinfo sfc | grep parm | wc -l) -lt 15 ]]; then
  echo 'Not enough sfc driver features detected. Assuming in-tree driver is loaded. Trying to dkms autoinstall.'
  dkms autoinstall
  dkms status
  rmmod sfc
  modprobe sfc
fi

if [[ $(modinfo sfc | grep parm | wc -l) -lt 15 ]]; then
  echo 'Still not enough sfc driver features detected. Please install out-of-tree sfc to write SolarFlare firmware to the NICs. Aborting.'
  exit 1
fi
 
sfupdate --write -y
